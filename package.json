{
  "name": "black-myth-wukong-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate": "node --import tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/validate-data.test.ts",
    "prebuild": "npm run validate && npm run typecheck && npm test",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node --import tsx scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
